{
	"$schema": "vscode://schemas/color-theme",
	"name": "DevPulse Dark",
	"include": "../../theme-defaults/themes/dark_modern.json",
	"type": "dark",
	"colors": {
		"activityBar.background": "#0A0B10",
		"statusBar.background": "#0A0B10",
		"statusBar.noFolderBackground": "#0A0B10",
		"statusBar.debuggingBackground": "#0A0B10",

		"sideBar.background": "#12131A",
		"panel.background": "#12131A",
		"editorGroupHeader.tabsBackground": "#12131A",
		"tab.inactiveBackground": "#12131A",

		"editor.background": "#181920",
		"tab.activeBackground": "#181920",

		"activityBarBadge.background": "#6E00FF",
		"activityBar.activeBorder": "#6E00FF",
		"button.background": "#6E00FF",
		"button.hoverBackground": "#7E19FF",
		"badge.background": "#6E00FF",
		"progressBar.background": "#6E00FF",
		"tab.activeBorderTop": "#6E00FF",
		"extensionButton.prominentBackground": "#6E00FF",
		"extensionButton.prominentHoverBackground": "#7E19FF",

		"focusBorder": "#00E5FF",
		"textLink.foreground": "#00E5FF",
		"textLink.activeForeground": "#33EFFF",
		"pickerGroup.border": "#00E5FF",

		"statusBarItem.prominentBackground": "#FF3D71",
		"statusBarItem.prominentHoverBackground": "#FF5A87",
		"statusBarItem.errorBackground": "#FF3D71",
		"statusBarItem.warningBackground": "#FF8C00",

		"titleBar.activeBackground": "#0A0B10",
		"titleBar.inactiveBackground": "#0A0B10",

		"list.activeSelectionBackground": "#181920",
		"list.inactiveSelectionBackground": "#12131A",
		"list.hoverBackground": "#181920",
		"list.focusBackground": "#181920",

		"terminal.background": "#12131A",

		"dropdown.background": "#12131A",
		"input.background": "#12131A",
		"widget.shadow": "#00000080"
	},
	"tokenColors": [
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": { "foreground": "#C792EA" }
		},
		{
			"scope": ["string", "string punctuation.section.embedded source"],
			"settings": { "foreground": "#C3E88D" }
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": { "foreground": "#82AAFF" }
		},
		{
			"scope": ["constant", "constant.numeric", "support.constant"],
			"settings": { "foreground": "#F78C6C" }
		},
		{
			"scope": ["entity.name.tag", "support.class.component"],
			"settings": { "foreground": "#FF3D71" }
		},
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#546E7A" }
		},
		{
			"scope": ["variable.other", "variable.parameter"],
			"settings": { "foreground": "#EEFFFF" }
		}
	],
	"semanticHighlighting": true
}
