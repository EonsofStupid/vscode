	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#565F89"
			}
		},
		{
			"name": "String",
			"scope": "string",
			"settings": {
				"foreground": "#9ECE6A"
			}
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": {
				"foreground": "#89DDFF"
			}
		},
		{
			"name": "Number",
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#FF9E64"
			}
		},
		{
			"name": "Built-in constant",
			"scope": "constant.language",
			"settings": {
				"foreground": "#FF9E64"
			}
		},
		{
			"name": "User-defined constant",
			"scope": ["constant.character", "constant.other"],
			"settings": {
				"foreground": "#FF9E64"
			}
		},
		{
			"name": "Variable",
			"scope": "variable",
			"settings": {
				"fontStyle": "",
				"foreground": "#C0CAF5"
			}
		},
		{
			"name": "Keyword",
			"scope": ["keyword", "keyword.operator.new"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#BB9AF7"
			}
		},
		{
			"name": "Storage",
			"scope": "storage",
			"settings": {
				"fontStyle": "",
				"foreground": "#BB9AF7"
			}
		},
		{
			"name": "Storage type",
			"scope": "storage.type",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#BB9AF7"
			}
		},
		{
			"name": "Class name",
			"scope": "entity.name.class",
			"settings": {
				"foreground": "#E0AF68"
			}
		},
		{
			"name": "Inherited class",
			"scope": "entity.other.inherited-class",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E0AF68"
			}
		},
		{
			"name": "Function name",
			"scope": ["entity.name.function", "meta.function-call.generic"],
			"settings": {
				"fontStyle": "",
				"foreground": "#7AA2F7"
			}
		},
		{
			"name": "Function argument",
			"scope": "variable.parameter",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#E0AF68"
			}
		},
		{
			"name": "Tag name",
			"scope": "entity.name.tag",
			"settings": {
				"fontStyle": "",
				"foreground": "#F7768E"
			}
		},
		{
			"name": "Tag attribute",
			"scope": "entity.other.attribute-name",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#BB9AF7"
			}
		},
		{
			"name": "Library function",
			"scope": "support.function",
			"settings": {
				"fontStyle": "",
				"foreground": "#7DCFFF"
			}
		},
		{
			"name": "Library constant",
			"scope": "support.constant",
			"settings": {
				"fontStyle": "",
				"foreground": "#FF9E64"
			}
		},
		{
			"name": "Library class/type",
			"scope": ["support.type", "support.class"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#1ABC9C"
			}
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"settings": {
				"fontStyle": "",
				"foreground": "#F7768E"
			}
		},
		{
			"name": "JSON Key - Level 0",
			"scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"],
			"settings": {
				"foreground": "#7AA2F7"
			}
		},
		{
			"name": "Markdown - headings",
			"scope": "markup.heading",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#7AA2F7"
			}
		},
		{
			"name": "Markdown - italic",
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#BB9AF7"
			}
		},
		{
			"name": "Markdown - bold",
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#F7768E"
			}
		},
		{
			"name": "Markdown - raw block",
			"scope": ["markup.raw.block.markdown", "markup.raw.inline.markdown"],
			"settings": {
				"foreground": "#9ECE6A"
			}
		}
	],
	"semanticHighlighting": true
}
