{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 140
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": [
			"extensions/devpulse-hub/**",
			"extensions/devpulse-db-bridge/**",
			"extensions/devpulse-clyffy/**",
			"extensions/devpulse-antigravity/**",
			"extensions/devpulse-profile/**",
			"extensions/theme-devforge/**"
		]
	}
}
